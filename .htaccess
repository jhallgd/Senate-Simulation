Options -Indexes
RewriteEngine On

# Never expose environment files or hidden dotfiles.
<FilesMatch "^\.">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Deny from all
	</IfModule>
</FilesMatch>

<FilesMatch "^\.env(\..*)?$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Deny from all
	</IfModule>
</FilesMatch>

# Serve the application entrypoint from src when visiting the site root.
RewriteRule ^$ src/index.php [L]

# Allow direct access to anything under /src without rewriting again.
RewriteRule ^src/ - [L]

# If a file or folder already exists at this level, serve it directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, resolve the request from the src folder.
RewriteRule ^(.*)$ src/$1 [L]